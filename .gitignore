.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---- Datasets ----
# data/ IS tracked (curated train/val/test splits, ~133 MB, no file over 5 MB).
# Only the upstream raw downloads are excluded: the archives blow past GitHub's
# 100 MB per-file limit, and aider_raw/ can be re-extracted from AIDER.zip.
aider_raw/
*.zip
*.tar
*.tar.gz
*.7z

# Keep large derived caches out even though data/ is tracked
data/**/*.npy
data/**/*.npz
data/**/*.tfrecord
data/cache/

# ---- Model weights / exports ----
# models/ IS tracked (~204 MB, incl. the seed_42/43/44 checkpoints). Largest
# single file is 24 MB, under GitHub's 100 MB per-file cap, so no Git LFS needed.
# Stray weights dumped at the repo root are still excluded:
/*.keras
/*.h5
/*.hdf5
/*.tflite
/*.onnx
/*.pt
/*.pth
/*.pb
/*.ckpt
checkpoints/

# ---- Training artifacts ----
logs/
runs/
tensorboard/
wandb/
mlruns/
*.log
# ...but keep the committed training/Grad-CAM run logs
!reports/*.log
!reports/**/*.log

# ---- Node / the React dashboard ----
node_modules/
dashboard/dist/
.vite/
*.local
npm-debug.log*
# dashboard/public/data/dashboard.json IS tracked - it is the dashboard's whole input,
# and it is small (77 KB). Regenerate it with: npm run data

# ---- Streamlit / Gradio caches ----
.streamlit/secrets.toml
flagged/
